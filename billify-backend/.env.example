# ============================================================================
# BILLIFY BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# DO NOT COMMIT THIS FILE - Use .env for local development only
# This file shows the required variables - fill in actual values in .env
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# ============================================================================
# DATABASE CONFIGURATION (MongoDB)
# ============================================================================
# For local MongoDB:
#   MONGO_URI=mongodb://localhost:27017/billify
#
# For MongoDB Atlas:
#   1. Go to: https://www.mongodb.com/cloud/atlas
#   2. Create a cluster and generate connection string
#   3. Replace USERNAME and PASSWORD
#   MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster-name.mongodb.net/billify
#
# NEVER include actual credentials in this file!
MONGO_URI=your_mongodb_connection_string_here

# ============================================================================
# JWT Authentication Secret
# ============================================================================
# IMPORTANT: Generate a new strong secret:
#   Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Online:  https://generate-random.org/encryption-key-generator
#
# Minimum 32 characters recommended
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================================
# Get these from: https://dashboard.razorpay.com/app/keys
# Test keys start with: rzp_test_
# Live keys start with: rzp_live_
#
# NEVER commit real API keys!
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email Service (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Firebase Admin SDK (if backend needs it)
# FIREBASE_PROJECT_ID=billify-37eba
# FIREBASE_PRIVATE_KEY=your_firebase_private_key
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@billify-37eba.iam.gserviceaccount.com
