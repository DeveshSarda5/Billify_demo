# Environment Configuration for Billify Backend
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's already in .gitignore

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Get your MongoDB connection string from: https://www.mongodb.com/cloud/atlas
MONGO_URI=mongodb://localhost:27017/billify
# For MongoDB Atlas: MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/billify

# JWT Authentication
# Generate a strong secret: use 'openssl rand -base64 32' on Linux/Mac or online generator
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Razorpay Payment Gateway
# Get these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Email Service (if needed)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Firebase Admin SDK (if backend needs it)
# FIREBASE_PROJECT_ID=billify-37eba
# FIREBASE_PRIVATE_KEY=your_firebase_private_key
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@billify-37eba.iam.gserviceaccount.com
