# Frontend Environment Variables for Expo
# All authentication is handled via backend API
# No Firebase configuration needed

# Backend API Configuration
# For local development, use your machine IP (get with: ipconfig)
# For emulator/device, use host machine IP (NOT localhost)
# Example: http://192.168.1.100:5000/api  (replace with your machine IP)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
