# Frontend Environment Variables for Expo
# All authentication is handled via backend API

# Backend API Configuration
EXPO_PUBLIC_API_BASE_URL=https://your-backend.onrender.com/api

# Debug mode (set to false for production builds)
EXPO_PUBLIC_DEBUG_MODE=false

# OTA Updates
EXPO_PUBLIC_UPDATES_ENABLED=false
EXPO_PUBLIC_UPDATES_CHECK_AUTOMATICALLY=OFF
EXPO_PUBLIC_UPDATES_FALLBACK_TO_CACHE_TIMEOUT=0

# Razorpay (Frontend)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
