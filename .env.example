# Frontend Environment Variables for Expo
# All authentication is handled via backend API
# No Firebase configuration needed

# Backend API Configuration
# Use your HTTPS ngrok endpoint so any network/device can reach the backend.
# Example: https://your-subdomain.ngrok-free.app/api
EXPO_PUBLIC_API_BASE_URL=https://your-subdomain.ngrok-free.app/api

# Razorpay (Frontend)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
